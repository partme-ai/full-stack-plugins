{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "processon-design",
  "version": "0.3.2",
  "description": "可编辑的 ProcessOn 图表：生成前构造提示词，生成后做语义与一致性评审。",
  "author": {
    "name": "Full Stack Skills / PartMe.AI",
    "url": "https://github.com/partme-ai"
  },
  "homepage": "https://github.com/full-stack-plugins/processon-design-plugin",
  "repository": "https://github.com/full-stack-plugins/processon-design-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "processon",
    "diagram",
    "mind-map",
    "infographic",
    "mcp",
    "codex"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ProcessOn（图表绘制）",
        "shortDescription": "把流程图、架构图和思维导图变成可编辑的 ProcessOn 文件，生成前定结构，生成后做一致性评审。",
        "longDescription": "Operate ProcessOn from Codex to create professional flowcharts, swimlanes, UML, architecture and ER diagrams, mind maps, timelines, organization charts, and structured infographics with a built-in quality review workflow.",
        "developerName": "Full Stack Skills / PartMe.AI",
        "category": "Creativity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/full-stack-plugins/processon-design-plugin",
        "privacyPolicyURL": "https://github.com/full-stack-plugins/processon-design-plugin/blob/main/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/full-stack-plugins/processon-design-plugin/blob/main/TERMS.md",
        "defaultPrompt": [
          "Create a polished system architecture diagram in ProcessOn",
          "Turn this workflow into a clear cross-functional swimlane",
          "Make an editable mind map or infographic from this content"
        ],
        "brandColor": "#067BEF",
        "composerIcon": "./assets/official-logo.png",
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "screenshots": [
          "./assets/processon-hero.png"
        ],
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "ProcessOn Design"
    },
    "ai.partme": {
      "displayName": "ProcessOn（图表绘制）",
      "displayName_i18n": {
        "zh-CN": "ProcessOn（图表绘制）"
      },
      "description_i18n": {
        "zh-CN": "可编辑的 ProcessOn 图表：生成前构造提示词，生成后做语义与一致性评审。"
      }
    }
  }
}
